      {
        "id": "sg-test-001",
        "name": "test-security-group",
        "resourceType": "aws-security-group",
        "configuration": {
          "awsSecurityGroupId": "test-security-group",
          "name": "test-sg",
          "awsVpcId": "vpc-test-001",
          "description": "Test security group for validation",
          "ingressRules": [
            {
              "protocol": "tcp",
              "fromPort": 22,
              "toPort": 22,
              "cidrBlocks": ["0.0.0.0/0"],
              "description": "SSH access"
            },
            {
              "protocol": "tcp",
              "fromPort": 80,
              "toPort": 80,
              "cidrBlocks": ["0.0.0.0/0"],
              "description": "HTTP access"
            }
          ],
          "egressRules": [
            {
              "protocol": "-1",
              "fromPort": 0,
              "toPort": 0,
              "cidrBlocks": ["0.0.0.0/0"],
              "description": "Allow all outbound"
            }
          ],
          "tags": {
            "Name": "test-security-group"
          }
        },
        "parentId": "vpc-test-001",
        "dependencies": ["vpc-test-001"]
      },
      {
        "id": "ec2-test-001",
        "name": "test-ec2-instance",
        "resourceType": "aws-ec2",
        "configuration": {
          "awsEc2Id": "test-ec2-instance",
          "instanceType": "t3.micro",
          "amiId": "ami-0c55b159cbfafe1f0",
          "subnetId": "subnet-private-001",
          "securityGroups": ["sg-test-001"],
          "keyPairName": "test-key",
          "associatePublicIpAddress": false,
          "rootVolumeSize": 20,
          "rootVolumeType": "gp3",
          "encrypted": true,
          "deleteOnTermination": true,
          "detailedMonitoring": false,
          "terminationProtection": false,
          "tags": {
            "Name": "test-ec2-instance",
            "Environment": "test"
          }
        },
        "parentId": "subnet-private-001",
        "dependencies": ["subnet-private-001", "sg-test-001"]
