{
  "architectureData": {
    "metadata": {
      "name": "Bastion Host Architecture",
      "description": "Secure bastion host setup with private instances accessible through a bastion host in public subnet",
      "version": "1.0.0",
      "provider": "aws",
      "region": "us-east-1",
      "environment": "production",
      "project": "bastion-infrastructure",
      "createdAt": "2025-09-09T12:00:00.000Z",
      "lastModified": "2025-09-09T12:00:00.000Z",
      "tags": {
        "Environment": "production",
        "Project": "bastion-infrastructure",
        "Security": "high",
        "Purpose": "bastion-host"
      }
    },
    "nodes": [
      {
        "id": "main-vpc",
        "resourceType": "vpc",
        "name": "bastion-vpc",
        "nodeType": "awsService",
        "position": {
          "x": 100,
          "y": 100
        },
        "configuration": {
          "cidr_block": "10.0.0.0/16",
          "enable_dns_hostnames": true,
          "enable_dns_support": true,
          "tags": {
            "Name": "bastion-vpc",
            "Environment": "production"
          }
        }
      },
      {
        "id": "public-subnet",
        "resourceType": "subnet",
        "name": "bastion-public-subnet",
        "nodeType": "awsService",
        "position": {
          "x": 200,
          "y": 200
        },
        "configuration": {
          "vpc_id": "main-vpc",
          "cidr_block": "10.0.1.0/24",
          "availability_zone": "us-east-1a",
          "subnet_type": "public",
          "map_public_ip_on_launch": true,
          "tags": {
            "Name": "bastion-public-subnet",
            "Type": "Public",
            "Purpose": "bastion-host"
          }
        }
      },
      {
        "id": "private-subnet-1",
        "resourceType": "subnet",
        "name": "private-subnet-1",
        "nodeType": "awsService",
        "position": {
          "x": 300,
          "y": 200
        },
        "configuration": {
          "vpc_id": "main-vpc",
          "cidr_block": "10.0.2.0/24",
          "availability_zone": "us-east-1a",
          "subnet_type": "private",
          "map_public_ip_on_launch": false,
          "tags": {
            "Name": "private-subnet-1",
            "Type": "Private",
            "Purpose": "application-tier"
          }
        }
      },
      {
        "id": "private-subnet-2",
        "resourceType": "subnet",
        "name": "private-subnet-2",
        "nodeType": "awsService",
        "position": {
          "x": 400,
          "y": 200
        },
        "configuration": {
          "vpc_id": "main-vpc",
          "cidr_block": "10.0.3.0/24",
          "availability_zone": "us-east-1b",
          "subnet_type": "private",
          "map_public_ip_on_launch": false,
          "tags": {
            "Name": "private-subnet-2",
            "Type": "Private",
            "Purpose": "database-tier"
          }
        }
      },
      {
        "id": "bastion-security-group",
        "resourceType": "security-group",
        "name": "bastion-sg",
        "nodeType": "awsService",
        "position": {
          "x": 150,
          "y": 300
        },
        "configuration": {
          "name": "bastion-sg",
          "description": "Security group for bastion host - SSH access only",
          "vpc_id": "main-vpc",
          "ingress_rules": [
            {
              "from_port": 22,
              "to_port": 22,
              "protocol": "tcp",
              "cidr_blocks": ["0.0.0.0/0"],
              "description": "SSH access from internet"
            }
          ],
          "egress_rules": [
            {
              "from_port": 22,
              "to_port": 22,
              "protocol": "tcp",
              "cidr_blocks": ["10.0.0.0/16"],
              "description": "SSH to private instances"
            },
            {
              "from_port": 80,
              "to_port": 80,
              "protocol": "tcp",
              "cidr_blocks": ["0.0.0.0/0"],
              "description": "HTTP for updates"
            },
            {
              "from_port": 443,
              "to_port": 443,
              "protocol": "tcp",
              "cidr_blocks": ["0.0.0.0/0"],
              "description": "HTTPS for updates"
            }
          ],
          "tags": {
            "Name": "bastion-security-group",
            "Purpose": "bastion-host"
          }
        }
      },
      {
        "id": "private-security-group",
        "resourceType": "security-group",
        "name": "private-sg",
        "nodeType": "awsService",
        "position": {
          "x": 350,
          "y": 300
        },
        "configuration": {
          "name": "private-sg",
          "description": "Security group for private instances - SSH from bastion only",
          "vpc_id": "main-vpc",
          "ingress_rules": [
            {
              "from_port": 22,
              "to_port": 22,
              "protocol": "tcp",
              "security_group_ids": ["bastion-security-group"],
              "description": "SSH access from bastion host only"
            },
            {
              "from_port": 80,
              "to_port": 80,
              "protocol": "tcp",
              "cidr_blocks": ["10.0.0.0/16"],
              "description": "HTTP within VPC"
            },
            {
              "from_port": 443,
              "to_port": 443,
              "protocol": "tcp",
              "cidr_blocks": ["10.0.0.0/16"],
              "description": "HTTPS within VPC"
            }
          ],
          "egress_rules": [
            {
              "from_port": 0,
              "to_port": 0,
              "protocol": "-1",
              "cidr_blocks": ["0.0.0.0/0"],
              "description": "All outbound traffic"
            }
          ],
          "tags": {
            "Name": "private-security-group",
            "Purpose": "private-instances"
          }
        }
      },
      {
        "id": "bastion-host",
        "resourceType": "ec2",
        "name": "bastion-host",
        "nodeType": "awsService",
        "position": {
          "x": 200,
          "y": 400
        },
        "configuration": {
          "instance_type": "t3.nano",
          "ami_id": "ami-0c55b159cbfafe1d0",
          "key_pair": "bastion-key-pair",
          "subnet_id": "public-subnet",
          "security_group_ids": ["bastion-security-group"],
          "associate_public_ip_address": true,
          "monitoring": true,
          "ebs_optimized": false,
          "root_block_device": {
            "volume_type": "gp3",
            "volume_size": 8,
            "delete_on_termination": true,
            "encrypted": true
          },
          "ebs_block_device": [],
          "user_data": "#!/bin/bash\nyum update -y\nyum install -y aws-cli\n# Configure bastion host security\necho 'Port 22' >> /etc/ssh/sshd_config\necho 'PermitRootLogin no' >> /etc/ssh/sshd_config\necho 'PasswordAuthentication no' >> /etc/ssh/sshd_config\nsystemctl restart sshd",
          "tags": {
            "Name": "bastion-host",
            "Environment": "production",
            "Purpose": "bastion-host",
            "Backup": "required"
          }
        }
      },
      {
        "id": "private-app-server-1",
        "resourceType": "ec2",
        "name": "app-server-1",
        "nodeType": "awsService",
        "position": {
          "x": 300,
          "y": 400
        },
        "configuration": {
          "instance_type": "t3.small",
          "ami_id": "ami-0c55b159cbfafe1d0",
          "key_pair": "app-key-pair",
          "subnet_id": "private-subnet-1",
          "security_group_ids": ["private-security-group"],
          "associate_public_ip_address": false,
          "monitoring": true,
          "ebs_optimized": true,
          "root_block_device": {
            "volume_type": "gp3",
            "volume_size": 20,
            "delete_on_termination": true,
            "encrypted": true
          },
          "ebs_block_device": [],
          "iam_instance_profile": "app-server-role",
          "tags": {
            "Name": "app-server-1",
            "Environment": "production",
            "Tier": "application",
            "Backup": "required"
          }
        }
      },
      {
        "id": "private-app-server-2",
        "resourceType": "ec2",
        "name": "app-server-2",
        "nodeType": "awsService",
        "position": {
          "x": 400,
          "y": 400
        },
        "configuration": {
          "instance_type": "t3.small",
          "ami_id": "ami-0c55b159cbfafe1d0",
          "key_pair": "app-key-pair",
          "subnet_id": "private-subnet-2",
          "security_group_ids": ["private-security-group"],
          "associate_public_ip_address": false,
          "monitoring": true,
          "ebs_optimized": true,
          "root_block_device": {
            "volume_type": "gp3",
            "volume_size": 20,
            "delete_on_termination": true,
            "encrypted": true
          },
          "ebs_block_device": [],
          "iam_instance_profile": "app-server-role",
          "tags": {
            "Name": "app-server-2",
            "Environment": "production",
            "Tier": "application",
            "Backup": "required"
          }
        }
      },
      {
        "id": "internet-gateway",
        "resourceType": "internet-gateway",
        "name": "main-igw",
        "nodeType": "awsService",
        "position": {
          "x": 100,
          "y": 50
        },
        "configuration": {
          "vpc_id": "main-vpc",
          "tags": {
            "Name": "main-igw",
            "Environment": "production"
          }
        }
      },
      {
        "id": "nat-gateway",
        "resourceType": "nat-gateway",
        "name": "main-nat",
        "nodeType": "awsService",
        "position": {
          "x": 200,
          "y": 150
        },
        "configuration": {
          "subnet_id": "public-subnet",
          "allocation_id": "eip-allocation-id",
          "tags": {
            "Name": "main-nat",
            "Environment": "production"
          }
        }
      }
    ],
    "connections": [
      {
        "id": "vpc-to-public-subnet",
        "source": "main-vpc",
        "target": "public-subnet",
        "type": "contains"
      },
      {
        "id": "vpc-to-private-subnet-1",
        "source": "main-vpc",
        "target": "private-subnet-1",
        "type": "contains"
      },
      {
        "id": "vpc-to-private-subnet-2",
        "source": "main-vpc",
        "target": "private-subnet-2",
        "type": "contains"
      },
      {
        "id": "vpc-to-bastion-sg",
        "source": "main-vpc",
        "target": "bastion-security-group",
        "type": "contains"
      },
      {
        "id": "vpc-to-private-sg",
        "source": "main-vpc",
        "target": "private-security-group",
        "type": "contains"
      },
      {
        "id": "vpc-to-igw",
        "source": "main-vpc",
        "target": "internet-gateway",
        "type": "contains"
      },
      {
        "id": "public-subnet-to-bastion",
        "source": "public-subnet",
        "target": "bastion-host",
        "type": "contains"
      },
      {
        "id": "public-subnet-to-nat",
        "source": "public-subnet",
        "target": "nat-gateway",
        "type": "contains"
      },
      {
        "id": "private-subnet-1-to-app-1",
        "source": "private-subnet-1",
        "target": "private-app-server-1",
        "type": "contains"
      },
      {
        "id": "private-subnet-2-to-app-2",
        "source": "private-subnet-2",
        "target": "private-app-server-2",
        "type": "contains"
      },
      {
        "id": "bastion-sg-to-bastion",
        "source": "bastion-security-group",
        "target": "bastion-host",
        "type": "secures"
      },
      {
        "id": "private-sg-to-app-1",
        "source": "private-security-group",
        "target": "private-app-server-1",
        "type": "secures"
      },
      {
        "id": "private-sg-to-app-2",
        "source": "private-security-group",
        "target": "private-app-server-2",
        "type": "secures"
      },
      {
        "id": "bastion-to-app-1",
        "source": "bastion-host",
        "target": "private-app-server-1",
        "type": "connects_to"
      },
      {
        "id": "bastion-to-app-2",
        "source": "bastion-host",
        "target": "private-app-server-2",
        "type": "connects_to"
      }
    ],
    "variables": {
      "region": {
        "description": "AWS region for deployment",
        "type": "string",
        "default": "us-east-1"
      },
      "environment": {
        "description": "Environment name",
        "type": "string",
        "default": "production"
      },
      "key_pair_name": {
        "description": "Name of the key pair for EC2 instances",
        "type": "string",
        "default": "bastion-key-pair"
      },
      "allowed_cidr": {
        "description": "CIDR block allowed to SSH to bastion host",
        "type": "string",
        "default": "0.0.0.0/0"
      }
    },
    "outputs": {
      "bastion_public_ip": {
        "description": "Public IP address of the bastion host",
        "value": "${aws_instance.bastion-host.public_ip}"
      },
      "vpc_id": {
        "description": "ID of the VPC",
        "value": "${aws_vpc.main-vpc.id}"
      },
      "private_subnet_ids": {
        "description": "IDs of the private subnets",
        "value": "${[aws_subnet.private-subnet-1.id, aws_subnet.private-subnet-2.id]}"
      }
