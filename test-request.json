          "awsPublicSubnetId": "test-public-subnet",
          "cidrBlock": "10.0.1.0/24",
          "awsVpcId": "vpc-test-001",
          "awsAvailabilityZone": "us-east-1a",
          "mapPublicIpOnLaunch": true,
          "tags": {
            "Name": "test-public-subnet",
            "Type": "Public"
          }
        },
        "parentId": "vpc-test-001",
        "dependencies": ["vpc-test-001"]
      },
      {
        "id": "nat-gateway-001",
        "name": "test-nat-gateway",
