{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon",
    "cli": "npm run build && node dist/index.js --cli",
    "test": "echo 'Run tests with: npm run test:modular'",
    "test:modular": "curl -X GET http://localhost:3000/api/modules",
    "docker:build": "docker build -t darch-backend .",
    "docker:build:dev": "docker build -f Dockerfile.dev -t darch-backend-dev .",
    "docker:run": "docker run --rm -p 5000:5000 -v $(pwd)/src/output:/app/src/output darch-backend",
    "docker:dev": "./dev.sh",
    "docker:prod": "./deploy.sh",
    "docker:logs": "docker logs -f darch-backend-api",
    "docker:logs:dev": "docker logs -f darch-backend-dev",
    "docker:stop": "docker stop darch-backend-api darch-backend-dev 2>/dev/null || true",
    "docker:clean": "npm run docker:stop && docker rm darch-backend-api darch-backend-dev 2>/dev/null || true && docker rmi darch-backend darch-backend-dev 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^24.1.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/archiver": "^6.0.3",
    "@types/dotenv": "^6.1.1",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "http-status-codes": "^2.3.0",
    "mongoose": "^8.16.5"
  }
}
