        "Project": "Darch-Validation",
        "Phase": "1-4-Complete"
      }
    },
    "nodes": [
      {
        "id": "vpc-test-001",
        "name": "test-vpc",
        "resourceType": "aws-vpc",
        "configuration": {
          "awsVpcId": "test-vpc",
          "cidrBlock": "10.0.0.0/16",
          "enableDnsHostnames": true,
          "enableDnsSupport": true,
          "instanceTenancy": "default",
          "tags": {
            "Name": "test-vpc",
            "Type": "VPC"
          }
        },
        "parentId": null,
        "dependencies": []
      },
      {
        "id": "igw-test-001",
        "name": "test-igw",
        "resourceType": "aws-internet-gateway",
        "configuration": {
