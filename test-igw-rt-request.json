				"nodeType": "awsService",
				"position": {
					"x": 200,
					"y": 50
				},
				"configuration": {
					"awsVpcId": "main-vpc",
					"createDefaultRoute": true,
					"tags": {
						"Name": "main-internet-gateway",
						"Environment": "development"
					}
				}
			},
			{
				"id": "public-route-table",
				"resourceType": "aws-route-table",
