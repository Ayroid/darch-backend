          "createEip": true,
          "tags": {
            "Name": "test-nat-gateway"
          }
        },
        "parentId": "subnet-public-001",
        "dependencies": ["subnet-public-001"]
      },
      {
        "id": "subnet-private-001",
        "name": "test-private-subnet",
        "resourceType": "aws-private-subnet",
        "configuration": {
          "awsPrivateSubnetId": "test-private-subnet",
          "cidrBlock": "10.0.2.0/24",
          "awsVpcId": "vpc-test-001",
          "awsAvailabilityZone": "us-east-1a",
          "mapPublicIpOnLaunch": false,
          "enableNatGateway": true,
          "tags": {
            "Name": "test-private-subnet",
            "Type": "Private"
          }
